# Copy this file to .env and fill in your actual database details to connect to RDS
# The docker-compose.yml will automatically pick up these values.

ENVIRONMENT=prod

# Replace these placeholders with your actual AWS RDS connection details
# Format: postgresql://[user]:[password]@[rds-endpoint]:5432/[database_name]
DATABASE_URL=postgresql://postgres:your_password@your-rds-database-1.cxxxxx.ap-south-1.rds.amazonaws.com:5432/chitfund_db
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
